#--------------------------------------------------------------------
# WSC2026 — local development configuration
#--------------------------------------------------------------------
# Copy to .env for local development:  cp .env.example .env
#
# .env is gitignored, so it stays on your machine. The deployed configuration
# lives in .env.prod instead — docker-entrypoint.sh copies it over .env when the
# container starts. CodeIgniter reads .env by itself; these values are the ONLY
# place the connection is configured, and nothing is hardcoded in
# app/Config/Database.php, the Dockerfile or docker-compose.yml.
#
# Check it with:  curl -fsS http://localhost/api/db-check

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# DATABASE — MySQL, the same engine the deployed app uses
#--------------------------------------------------------------------
database.default.hostname = db
database.default.port = 3306
database.default.database = app
database.default.username = app
database.default.password = app
database.default.DBDriver = MySQLi
database.default.DBPrefix =

#--------------------------------------------------------------------
# The same local database, for the MySQL container Compose starts
#--------------------------------------------------------------------
# Compose cannot read CodeIgniter's dotted keys — a variable name there may not
# contain dots — so the same values are repeated in plain form below. Keep the
# two blocks in step; they describe one database. The deployed database is
# managed for you, so .env.prod needs none of these.
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root

# Running PHP on your own machine instead of in the container? The database is
# published on localhost, so use database.default.hostname = 127.0.0.1

#--------------------------------------------------------------------
# Using SQLite instead?
#--------------------------------------------------------------------
# The image still carries the SQLite3 driver, so this works:
#
#   database.default.DBDriver = SQLite3
#   database.default.database = database.db
#
# The filename must NOT contain a directory separator.
# system/Database/SQLite3/Connection.php prepends WRITEPATH only when the value
# has no separator in it; write "writable/database.db" and it is resolved against
# the current working directory instead — which is not the project root — and
# every connection fails with "Unable to open database file".
