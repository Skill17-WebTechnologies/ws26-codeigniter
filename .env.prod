#--------------------------------------------------------------------
# WSC2026 — deployed configuration
#--------------------------------------------------------------------
# docker-entrypoint.sh copies this file over .env on every container start, so
# this — not the .env you edit locally — is what the deployed app runs against.
#
# The competition platform fills in this competitor's own MySQL credentials when
# the repository is created. Leave the values empty rather than guessing: an
# empty value makes /api/db-check report "not configured", which is a far clearer
# signal than connecting to the wrong database.

CI_ENVIRONMENT = production

database.default.hostname =
database.default.port = 3306
database.default.database =
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
